APP_NAME=Portfolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5174

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

# In development e-mails are caught by Mailpit (http://localhost:8026).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="portfolio@example.com"
MAIL_FROM_NAME="Portfolio"

# Bcrypt hash of the admin password: generate it with
#   docker compose exec app php artisan admin:hash-password
# and paste it here in single quotes. It is the only way to change the password.
ADMIN_PASSWORD_HASH=
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_DECAY_MINUTES=15

# Where to forward the messages of the contact form (empty = admin only).
CONTACT_NOTIFY_EMAIL=
CONTACT_MAX_PER_HOUR=5
CONTACT_MAX_GLOBAL_PER_HOUR=60

# Automatic Italian → English translation of the admin content (DeepL API Free:
# free account at https://www.deepl.com/pro-api, the key ends with ":fx").
# Empty = no automatic translation: empty English texts show the Italian ones.
DEEPL_API_KEY=
DEEPL_TARGET_LANG=EN-US
# Only if DeepL gives an API address different from the one inferred from the key.
DEEPL_API_URL=
