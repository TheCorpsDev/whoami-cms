# Name and meta tags of the site, read when the frontend is built
# (npm run build). Copy this file to .env, or set the same names as
# GitHub repository variables: the publish workflow passes them to the build.
VITE_SITE_NAME="Alex Rossi"
VITE_SITE_TAGLINE="Backend Developer"
VITE_SITE_DESCRIPTION="Personal portfolio: projects, experience and contacts."
# Home-screen name on phones and the two letters of the logo in the admin.
VITE_SITE_SHORT_NAME="Alex R."
VITE_SITE_INITIALS="AR"
