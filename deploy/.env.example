# /opt/whoami-cms/.env — read by both Docker Compose and Laravel.
# Values containing a $ character must be wrapped in single quotes.

# Docker Hub images (same values as the GitHub repository variables)
DOCKERHUB_USERNAME=your-dockerhub-user
DOCKERHUB_REPOSITORY=whoami-cms
DOCKERHUB_IMAGE_PREFIX=site
STORAGE_VOLUME_NAME=whoami_storage
PROXY_NETWORK=proxy

# Laravel
APP_NAME=Portfolio
APP_ENV=production
APP_DEBUG=false
# Generate it with: docker run --rm php:8.4-cli-alpine php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
APP_KEY=
APP_URL=https://www.example.com
APP_LOCALE=it
APP_FALLBACK_LOCALE=it

LOG_CHANNEL=stderr
# JSON logs: a log shipper such as Promtail can read level and channel from them.
LOG_STDERR_FORMATTER='Monolog\Formatter\JsonFormatter'
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database/portfolio.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Outgoing e-mail over SMTP (Resend, Mailgun, Brevo...): use a dedicated key.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=portfolio@example.com
MAIL_FROM_NAME=Portfolio

# Admin: paste here the output of
#   docker compose exec app php artisan admin:hash-password
ADMIN_PASSWORD_HASH=
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_DECAY_MINUTES=15

# Where to forward the messages of the contact form (empty = admin only)
CONTACT_NOTIFY_EMAIL=
CONTACT_MAX_PER_HOUR=5
CONTACT_MAX_GLOBAL_PER_HOUR=60

# Automatic Italian → English translation of the admin content (DeepL API Free:
# free account at https://www.deepl.com/pro-api, the key ends with ":fx").
# Empty = no automatic translation: empty English texts show the Italian ones.
DEEPL_API_KEY=
DEEPL_TARGET_LANG=EN-US
# Only if DeepL gives an API address different from the one inferred from the key.
DEEPL_API_URL=
